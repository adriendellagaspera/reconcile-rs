#!/usr/bin/env bash
set -Eeuo pipefail

echo "Running gitleaks"
gitleaks protect --staged --redact --no-banner

TEMPDIR=$(mktemp -d)
trap 'rm -rf "$TEMPDIR"' EXIT SIGHUP SIGINT SIGQUIT SIGTERM
git checkout-index --prefix="$TEMPDIR/" -af

echo "Running cargo fmt"
(cd $TEMPDIR; cargo fmt --check)

echo "Running doc-budget check"
(cd $TEMPDIR; ./scripts/check-doc-budget.sh)

echo "Running domain-purity check"
(cd $TEMPDIR; ./scripts/check-domain-purity.sh)

echo "Running doc-structure check"
(cd $TEMPDIR; ./scripts/check-doc-structure.sh)

echo "Running test-file-naming check"
(cd $TEMPDIR; ./scripts/check-test-file-naming.sh)

echo "Running file-size check"
(cd $TEMPDIR; ./scripts/check-file-size.sh)
